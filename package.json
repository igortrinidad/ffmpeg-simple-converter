{
  "name": "mediacript",
  "version": "1.1.2",
  "description": "CLI and library to convert media files to performant formats and extract text using Groq and OpenAI's Whisper API",
  "type": "module",
  "main": "./dist/cjs/lib.js",
  "module": "./dist/esm/lib.js",
  "types": "./dist/esm/lib.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/lib.d.ts",
        "default": "./dist/esm/lib.js"
      },
      "require": {
        "types": "./dist/cjs/lib.d.ts",
        "default": "./dist/cjs/lib.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mediacript": "./cli.mjs",
    "mediacript-convert": "./convert.js"
  },
  "files": [
    "dist",
    "cli.mjs",
    "convert.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/igortrinidad/mediacript.git"
  },
  "bugs": {
    "url": "https://github.com/igortrinidad/mediacript/issues"
  },
  "homepage": "https://github.com/igortrinidad/mediacript#readme",
  "scripts": {
    "convert": "node convert.js",
    "start": "node --loader ts-node/esm src/index.ts",
    "build": "npm run build:esm && npm run build:cjs && npm run build:post",
    "build:esm": "tsc",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:post": "cp dist-esm-package.json dist/esm/package.json && cp dist-cjs-package.json dist/cjs/package.json && chmod +x dist/esm/index.js && chmod +x cli.mjs",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "inquirer": "^8.2.6",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.12",
    "@types/node": "^25.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
